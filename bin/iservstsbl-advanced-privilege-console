#!/bin/sh
set -e

umask 0002

CONSOLE_BIN=/usr/share/iserv/stsbl-advanced-privilege/app/bin/console
USER_WEB=iserv-stsbl-advanced-privilege
USER_WEB_UID="$(id -u "$USER_WEB")"
EUID="$(id -u)"

export APP_SECRET_FILE=/var/lib/iserv/stsbl-advanced-privilege/pwd/symfony.secret

if [ -z "$USER_WEB_UID" ]
then
  echo "$0: User $USER_WEB not found." >&2
  exit 1
fi

if [ "$USER_WEB_UID" = "$EUID" ]
then
  exec "$CONSOLE_BIN" "$@"
elif [ "0" = "$EUID" ]
then
  exec setpriv --reuid "$USER_WEB" --regid "$USER_WEB" --init-groups "$CONSOLE_BIN" "$@"
else
  echo "$0: Permission denied" >&2
  exit 1
fi
